{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:chicken",
      "materials": {
        "default": "chicken",
        "legs": "chicken_legs",
        "oracle": "olympus_oracle_glow"
      },
      "textures": {
        "default": "textures/entity/chicken",
        "oracle": "textures/entity/oracle_gold"
      },
      "geometry": {
        "default": "geometry.chicken",
        "oracle_default": "geometry.olympus.oracle.chicken"
      },
      "animations": {
        "move": "animation.chicken.move",
        "general": "animation.chicken.general.v1.0",
        "look_at_target": "animation.common.look_at_target",
        "baby_transform": "animation.chicken.baby_transform"
      },
      "scripts": {
        "animate": [
          "general",
          {
            "move": "query.modified_move_speed"
          },
          "look_at_target",
          {
            "baby_transform": "query.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.chicken",
        {
          "controller.render.olympus.oracle.chicken.v1.0.entity": "query.property('olympus:oracle_visible')"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg",
        "texture_index": 0
      }
    }
  }
}
