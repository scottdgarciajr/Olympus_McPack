{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:dolphin",
      "materials": {
        "default": "dolphin",
        "oracle": "olympus_oracle_glow"
      },
      "textures": {
        "default": "textures/entity/dolphin",
        "oracle": "textures/entity/oracle_gold"
      },
      "geometry": {
        "default": "geometry.dolphin",
        "oracle_default": "geometry.olympus.oracle.dolphin"
      },
      "animations": {
        "move": "animation.dolphin.move",
        "move_controller": "controller.animation.dolphin.general"
      },
      "scripts": {
        "animate": [
          "move_controller"
        ]
      },
      "particle_effects": {
        "dolphin_move_particle": "minecraft:dolphin_move_particle"
      },
      "render_controllers": [
        "controller.render.dolphin",
        {
          "controller.render.olympus.oracle.dolphin.entity": "query.property('olympus:oracle_visible')"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg_dolphin"
      }
    }
  }
}
