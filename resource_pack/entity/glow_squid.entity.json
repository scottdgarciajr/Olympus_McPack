{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:glow_squid",
      "materials": {
        "default": "glow_squid",
        "oracle": "olympus_oracle_glow"
      },
      "textures": {
        "default": "textures/entity/glow_squid/glow_squid",
        "oracle": "textures/entity/oracle_gold"
      },
      "geometry": {
        "default": "geometry.squid",
        "oracle_default": "geometry.olympus.oracle.squid"
      },
      "animations": {
        "move": "animation.squid.move",
        "squid_rotate": "animation.squid.rotate"
      },
      "scripts": {
        "animate": [
          "move",
          "squid_rotate"
        ]
      },
      "render_controllers": [
        "controller.render.glow_squid",
        {
          "controller.render.olympus.oracle.glow_squid.entity": "query.property('olympus:oracle_visible')"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg_glow_squid"
      }
    }
  }
}
