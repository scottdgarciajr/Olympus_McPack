{
  "format_version": "1.8.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:tripod_camera",
      "materials": {
        "default": "camera",
        "oracle": "olympus_oracle_glow"
      },
      "textures": {
        "default": "textures/entity/camera_tripod",
        "oracle": "textures/entity/oracle_gold"
      },
      "geometry": {
        "default": "geometry.tripod_camera",
        "oracle_default": "geometry.olympus.oracle.tripod_camera"
      },
      "animations": {
        "neutral": "animation.tripod_camera.neutral"
      },
      "animation_controllers": [
        {
          "base": "controller.animation.tripod_camera.base_pose"
        }
      ],
      "render_controllers": [
        "controller.render.tripod_camera",
        {
          "controller.render.olympus.oracle.tripod_camera.entity": "query.property('olympus:oracle_visible')"
        }
      ]
    }
  }
}
