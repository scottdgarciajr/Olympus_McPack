{
  "format_version": "1.8.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:polar_bear",
      "materials": {
        "default": "polar_bear",
        "oracle": "olympus_oracle_glow"
      },
      "textures": {
        "default": "textures/entity/polarbear",
        "oracle": "textures/entity/oracle_gold"
      },
      "geometry": {
        "default": "geometry.polarbear",
        "oracle_default": "geometry.olympus.oracle.polarbear"
      },
      "animations": {
        "walk": "animation.quadruped.walk",
        "move": "animation.polarbear.move",
        "look_at_target": "animation.common.look_at_target",
        "baby_transform": "animation.polarbear.baby_transform"
      },
      "scripts": {
        "scale": "1.2"
      },
      "animation_controllers": [
        {
          "move": "controller.animation.polarbear.move"
        },
        {
          "baby": "controller.animation.polarbear.baby"
        }
      ],
      "render_controllers": [
        "controller.render.polarbear",
        {
          "controller.render.olympus.oracle.polar_bear.entity": "query.property('olympus:oracle_visible')"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg_polar_bear"
      }
    }
  }
}
