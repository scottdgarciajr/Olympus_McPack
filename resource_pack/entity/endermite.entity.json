{
  "format_version": "1.8.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:endermite",
      "materials": {
        "default": "endermite",
        "oracle": "olympus_oracle_glow"
      },
      "textures": {
        "default": "textures/entity/endermite",
        "oracle": "textures/entity/oracle_gold"
      },
      "geometry": {
        "default": "geometry.endermite",
        "oracle_default": "geometry.olympus.oracle.endermite"
      },
      "animations": {
        "move": "animation.endermite.move"
      },
      "animation_controllers": [
        {
          "move": "controller.animation.endermite.move"
        }
      ],
      "render_controllers": [
        "controller.render.endermite",
        {
          "controller.render.olympus.oracle.endermite.entity": "query.property('olympus:oracle_visible')"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg_endermite"
      }
    }
  }
}
