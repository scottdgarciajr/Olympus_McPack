{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:cow",
      "materials": {
        "default": "cow",
        "oracle": "olympus_oracle_glow"
      },
      "textures": {
        "default": "textures/entity/cow/cow",
        "oracle": "textures/entity/oracle_gold"
      },
      "geometry": {
        "default": "geometry.cow",
        "oracle_default": "geometry.olympus.oracle.cow"
      },
      "animations": {
        "setup": "animation.cow.setup.v1.0",
        "walk": "animation.quadruped.walk",
        "look_at_target": "animation.common.look_at_target",
        "baby_transform": "animation.cow.baby_transform"
      },
      "scripts": {
        "animate": [
          "setup",
          {
            "walk": "query.modified_move_speed"
          },
          "look_at_target",
          {
            "baby_transform": "query.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.cow",
        {
          "controller.render.olympus.oracle.cow.v1.0.entity": "query.property('olympus:oracle_visible')"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg",
        "texture_index": 1
      }
    }
  }
}
